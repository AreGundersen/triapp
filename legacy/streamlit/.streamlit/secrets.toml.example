# Kopier til .streamlit/secrets.toml lokalt, eller lim inn i Streamlit Cloud → App settings → Secrets.

[supabase]
url = "https://xxxx.supabase.co"
key = "eyJ...   (anon/public key)"

[strava]
client_id = "12345"
client_secret = "abc123..."
redirect_uri = "https://<din-app>.streamlit.app"   # lokalt: http://localhost:8501
