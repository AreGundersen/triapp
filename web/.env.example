# Kopier til web/.env (gitignored) lokalt. På Vercel: Settings → Environment Variables.

# Supabase → Data API (Project URL, bare roten) og Project Settings → API Keys → Publishable key
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Strava → strava.com/settings/api
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=abc123...

# Kun for daglig auto-synk via Vercel Cron (/api/cron/sync). Server-side, aldri i nettleseren.
# Supabase → Project Settings → API Keys → Secret key. CRON_SECRET: finn på en lang tilfeldig streng.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# CRON_SECRET=
